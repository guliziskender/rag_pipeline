# Anthropic API key used for the LLM (contextualization + answer generation).
ANTHROPIC_API_KEY=

# Shared secret required by every API request (sent as the X-API-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=

# Optional: where Chroma persists its data. Defaults to ./chroma_db.
# CHROMA_PERSIST_DIR=./chroma_db
